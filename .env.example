# ====================================
# العقل الثاني - Environment Variables
# ====================================
# للنشر على الاستضافة: أنشئ ملف .env وأدخل القيم أدناه
# أو حدد هذه المتغيرات في لوحة تحكم الاستضافة

# ── Notion Settings (مطلوب) ──
NOTION_API_KEY=ntn_你的密钥
NOTION_DATABASE_ID=你的数据库ID

# ── AI Settings (OpenCode Zen / OpenAI compatible) ──
OPENCODE_ZEN_API_URL=https://opencode.ai/zen/v1
OPENCODE_ZEN_API_KEY=sk_你的密钥
OPENCODE_ZEN_MODEL=big-pickle

# ── Server ──
PORT=3000

@echo off
chcp 65001 >nul
title العقل الثاني - جارٍ التشغيل...

:: ===========================
:: إيقاف أي نسخة سابقة
:: ===========================
for /f "tokens=5" %%a in ('netstat -aon ^| find ":3000" ^| find "LISTENING" 2^>nul') do (
    taskkill /F /PID %%a >nul 2>&1
)

:: ===========================
:: تشغيل الخادم
:: ===========================
cd /d "%~dp0"
start "" /min cmd /c "node server.js > logs\server.log 2>&1"

:: ===========================
:: انتظار حتى يبدأ الخادم
:: ===========================
timeout /t 2 /nobreak >nul

:: ===========================
:: فتح المتصفح
:: ===========================
start "" "http://localhost:3000"

exit
